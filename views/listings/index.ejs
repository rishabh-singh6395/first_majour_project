
<% layout("/layouts/boilerplate") %>

<body>
    <h2>Find a place to stay</h2>

    <!-- Filters Section -->
    <div class="filters-section mb-4">
        <div class="d-flex gap-4 overflow-x-auto pb-3" style="flex-wrap: nowrap;">
            <div class="text-center filter-item" style="min-width: 80px; cursor: pointer;">
                <div style="font-size: 22px; margin-bottom: 6px;">
                    <i class="fa-solid fa-fire"></i>
                </div>
                <span style="font-size: 12px;">Trending</span>
            </div>
            <div class="text-center filter-item" style="min-width: 80px; cursor: pointer;">
                <div style="font-size: 22px; margin-bottom: 6px;">
                    <i class="fa-solid fa-door-open"></i>
                </div>
                <span style="font-size: 12px;">Rooms</span>
            </div>
            <div class="text-center filter-item" style="min-width: 80px; cursor: pointer;">
                <div style="font-size: 22px; margin-bottom: 6px;">
                    <i class="fa-solid fa-city"></i>
                </div>
                <span style="font-size: 12px;">Iconic Cities</span>
            </div>
            <div class="text-center filter-item" style="min-width: 80px; cursor: pointer;">
                <div style="font-size: 22px; margin-bottom: 6px;">
                    <i class="fa-solid fa-mountain"></i>
                </div>
                <span style="font-size: 12px;">Mountains</span>
            </div>
            <div class="text-center filter-item" style="min-width: 80px; cursor: pointer;">
                <div style="font-size: 22px; margin-bottom: 6px;">
                    <i class="fa-solid fa-chess-rook"></i>
                </div>
                <span style="font-size: 12px;">Castles</span>
            </div>
            <div class="text-center filter-item" style="min-width: 80px; cursor: pointer;">
                <div style="font-size: 22px; margin-bottom: 6px;">
                    <i class="fa-solid fa-water"></i>
                </div>
                <span style="font-size: 12px;">Amazing Pools</span>
            </div>
            <div class="text-center filter-item" style="min-width: 80px; cursor: pointer;">
                <div style="font-size: 22px; margin-bottom: 6px;">
                    <i class="fa-solid fa-tent"></i>
                </div>
                <span style="font-size: 12px;">Camping</span>
            </div>
            <div class="text-center filter-item" style="min-width: 80px; cursor: pointer;">
                <div style="font-size: 22px; margin-bottom: 6px;">
                    <i class="fa-solid fa-tractor"></i>
                </div>
                <span style="font-size: 12px;">Farms</span>
            </div>
            <div class="text-center filter-item" style="min-width: 80px; cursor: pointer;">
                <div style="font-size: 22px; margin-bottom: 6px;">
                    <i class="fa-solid fa-snowflake"></i>
                </div>
                <span style="font-size: 12px;">Arctic</span>
            </div>
        </div>
    </div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">

    <% for(let listing of allListings){ %>
        <div class="col">
            <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
                <div class="card h-100 listing-card">
                    <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>">
                    <div class="card-body">
                        <h5 class="card-title"><%= listing.title %></h5>
                        <p class="card-text mb-2">
                            &#8377; <%= listing.price %> / night
                        </p>
                        <span class="btn btn-primary">View Listing</span>
                    </div>
                </div>
            </a>
        </div>
    <% } %>
</div>

  
    
</body>
